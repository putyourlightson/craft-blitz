{% extends 'blitz/_utilities/diagnostics/layouts/page' %}

{% set page = craft.blitz.diagnostics.getPage() %}
{% if page is null %}
    {% redirect 'blitz/diagnostics/pages' with error 'The page no longer exists or may have been refreshed.' %}
{% endif %}
{% set title = 'Tracked Nested ' ~ craft.blitz.diagnostics.getElementTypeMethod('pluralDisplayName') %}
{% set crumbs = [
    {
        html: tag('a', {
        class: 'crumb-link code',
        href: cpUrl('blitz/diagnostics/pages/page?pageId=' ~ page.id),
        text: page.uri,
    })
    },
] %}

{% block content %}
    {{ sprig('blitz/_utilities/diagnostics/_components/nestedElements', {
        siteId: siteId,
        cacheId: page.id,
        displayName: craft.blitz.diagnostics.getElementTypeMethod('displayName'),
        pluralDisplayName: craft.blitz.diagnostics.getElementTypeMethod('pluralDisplayName'),
        hasUris: craft.blitz.diagnostics.getElementTypeMethod('hasUris'),
    }) }}
{% endblock %}
