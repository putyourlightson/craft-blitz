{% extends 'blitz/_utilities/diagnostics/layouts/include' %}

{% set include = craft.blitz.diagnostics.getInclude() %}
{% if include is null %}
    {% redirect 'blitz/diagnostics/includes' with error 'The include no longer exists or may have been refreshed.' %}
{% endif %}
{% set element = craft.blitz.diagnostics.getElementOfType(include.id) %}
{% set title = 'Tracked Nested ' ~ craft.blitz.diagnostics.getElementTypeMethod('pluralDisplayName') %}
{% set crumbs = [
    {
        label: include.index,
        url: cpUrl('blitz/diagnostics/includes/include?includeId=' ~ include.id),
    },
] %}

{% block content %}
    {{ sprig('blitz/_utilities/diagnostics/_components/nestedElements', {
        siteId: siteId,
        cacheId: include.id,
        displayName: craft.blitz.diagnostics.getElementTypeMethod('displayName'),
        pluralDisplayName: craft.blitz.diagnostics.getElementTypeMethod('pluralDisplayName'),
        hasUris: craft.blitz.diagnostics.getElementTypeMethod('hasUris'),
    }) }}
{% endblock %}
