{% extends 'blitz/_utilities/diagnostics/layouts/element-queries' %}

{% set elementQuery = craft.blitz.diagnostics.getElementQueryRecord() %}
{% if elementQuery is null %}
    {% redirect 'blitz/diagnostics/element-queries' with error 'The element query no longer exists.' %}
{% endif %}
{% set title = elementQuery.index %}
{% set codeTitle = true %}
{% set crumbs = [
    {
        label: 'Tracked ' ~ craft.blitz.diagnostics.getElementTypeMethod('displayName', elementQuery.type) ~ ' Queries',
        url: cpUrl('blitz/diagnostics/element-queries/element-query-type', { 'elementType': craft.blitz.diagnostics.getElementTypeMethod('displayName', elementQuery.type) }),
    },
] %}

{% block content %}
    {{ sprig('blitz/_utilities/diagnostics/_components/uris', {
        siteId: siteId,
        queryId: elementQuery.id,
        displayName: 'URI',
        pluralDisplayName: 'URIs',
    }) }}
{% endblock %}
