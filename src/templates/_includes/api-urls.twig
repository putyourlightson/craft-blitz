{% import "_includes/forms" as forms %}

{% set cols = {
    action: {
        type: 'heading',
        heading: 'API Action'|t('blitz'),
        thin: true,
    },
    url: {
        type: 'html',
        heading: 'URL'|t('blitz'),
        class: 'code',
    },
} %}

{% set rows = [
    {
        action: "Clear Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/clear'),
    },
    {
        action: "Flush Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/flush'),
    },
    {
        action: "Purge Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/purge'),
    },
    {
        action: "Generate Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/generate'),
    },
    {
        action: "Remote Deploy"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/deploy'),
    },
    {
        action: "Refresh Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/refresh'),
    },
    {
        action: "Refresh Expired Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/refresh-expired'),
    },
    {
        action: "Refresh Site Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/refresh-site', { siteId: currentSite.id }),
    },
    {
        action: "Refresh Cached URLs"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/refresh-urls', { urls: siteUrl('page1') ~ ',' ~ siteUrl('page2') }),
    },
    {
        action: "Refresh Tagged Cache"|t('blitz'),
        url: siteUrl(craft.app.config.general.actionTrigger ~ '/blitz/cache/refresh-tagged', { tags: 'tag1,tag2,tag3' }),
    },
] %}

{{ forms.editableTableField({
    name: 'actions',
    id: 'actions',
    cols: cols,
    rows: rows,
    staticRows: true,
}) }}
